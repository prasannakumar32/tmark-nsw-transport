# Copy to .env and fill in. Use either the raw token or the full "apikey <token>" value.
# Get a free key: https://opendata.transport.nsw.gov.au  (sign up -> Create Application -> add the "Car Park API")
TFNSW_API_KEY=
TFNSW_BASE_URL=https://api.transport.nsw.gov.au/v1
PORT=4000

# Seconds to cache the upstream response (protects your API rate limit).
CACHE_SECONDS=30
