{
  "name": "tmark-nsw-transport-backend",
  "version": "1.0.0",
  "private": true,
  "description": "TfNSW car park and train sync workers and REST API",
  "type": "module",
  "main": "api/server.js",
  "scripts": {
    "start:api": "node api/server.js",
    "start:carpark-worker": "node workflow/carpark-worker.js",
    "start:train-worker": "node workflow/train-worker.js",
    "dev:api": "node --watch api/server.js",
    "dev:carpark-worker": "node --watch workflow/carpark-worker.js",
    "dev:train-worker": "node --watch workflow/train-worker.js"
  },
  "engines": {
    "node": ">=18"
  }
}
