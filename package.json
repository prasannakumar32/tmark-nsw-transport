{
  "name": "tmark-nsw-transport",
  "version": "1.0.0",
  "private": true,
  "description": "React frontend and native Node.js server for NSW car park occupancy",
  "workspaces": [
    "frontend"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "npm run build && node --watch backend/server.js",
    "build": "npm run build --workspace=frontend",
    "start": "npm run build && node backend/server.js"
  }
}
